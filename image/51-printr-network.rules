// First network connection: the printr service (and only it) drives NetworkManager, to scan and
// join the Wi-Fi picked in the app, and starts or stops its hotspot (hostapd).
polkit.addRule(function (action, subject) {
    if (subject.user != "printr") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0) {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "printr-hotspot.service") {
        return polkit.Result.YES;
    }
});
