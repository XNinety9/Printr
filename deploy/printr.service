# Serveur printr, installé par deploy/install.sh (voir le README, « Installation sur le Pi »).
# Le service tourne sous l'utilisateur système `printr` ; ses données, sa configuration et son
# binaire sont partagés avec le groupe `printr`, dont fait partie l'utilisateur du Pi : mises à
# jour, configuration et redémarrage se font ensuite sans sudo.
[Unit]
Description=printr, serveur d'impression de tickets
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/printr.env
ExecStart=/opt/printr/printr serve
Restart=on-failure
RestartSec=5
User=printr
Group=printr
# Accès à l'imprimante (règle udev : groupe lp).
SupplementaryGroups=lp
# Fichiers créés lisibles et modifiables par le groupe printr.
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Garde-fous : un ticket qui s'emballe ne peut pas faire tomber la machine.
MemoryMax=400M
TasksMax=256
# Aucun privilège, noyau et système intouchables, seulement des sockets réseau ordinaires.
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# Cache des contenus du jour (horoscopes, mots du jour) : /var/cache/printr.
CacheDirectory=printr
CacheDirectoryMode=2770
# Comptes, presets, planifications, historique et photos : /var/lib/printr.
StateDirectory=printr
StateDirectoryMode=2770

[Install]
WantedBy=multi-user.target
