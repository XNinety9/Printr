# printr service configuration on the Raspberry Pi image. Everything else (printer, language, city,
# Claude, MQTT…) is set in the app: My account → Settings. What is set here wins.

# The app on port 80: http://printr.local
PRINTR_LISTEN=0.0.0.0:80

# No network at boot: "Printr-XXXX" hotspot and a ticket to set up the Wi-Fi.
PRINTR_WIFI_SETUP=1

# Offline horoscope (https://github.com/XNinety9/Barnum).
PRINTR_BARNUM="python3 /opt/barnum/main.py"
